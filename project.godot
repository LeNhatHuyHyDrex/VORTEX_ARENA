; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="VORTEX ARENA"
config/description="Game đối kháng 1v1 góc nhìn từ trên xuống. Mỗi tướng có bộ kỹ năng
tương tác với nhau để người chơi tự sáng tạo combo. Hỗ trợ LAN."
config/version="0.1.0"
run/main_scene="res://scenes/MainMenu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.043, 0.043, 0.055, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

Settings="*res://scripts/autoload/Settings.gd"
GameData="*res://scripts/autoload/GameData.gd"
Audio="*res://scripts/autoload/Audio.gd"
Net="*res://scripts/autoload/Net.gd"
InputSetup="*res://scripts/autoload/InputSetup.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="champions"
2d_physics/layer_3="projectiles"
2d_physics/layer_4="pickups"

[physics]

2d/default_gravity=0.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_2d=1
environment/defaults/default_clear_color=Color(0.043, 0.043, 0.055, 1)
